# Copy to .env for local dev. Only VITE_ vars — never put secrets here.
# The app is served same-origin by the API server, so the default (same
# origin, empty) is correct for production. Set this only for local dev
# against a remote API host.
VITE_API_BASE_URL=
# Optional: override the app name shown in the install prompt.
VITE_APP_NAME=Jaraa
# --- Google OAuth ("Continue with Google") ---
# Set to "true" to render the Google sign-in button. The button hides itself
# (renders null) when this is not "true", so the UI degrades gracefully.
VITE_GOOGLE_OAUTH_ENABLED=false
# Supabase project URL — used to build the Google authorize redirect.
VITE_SUPABASE_URL=
# Public app URL — used for the OAuth redirect_to callback (falls back to
# window.location.origin when unset).
VITE_PUBLIC_BASE_URL=
