# Jaraa server — environment template.
# Copy to .env and fill in. NEVER commit real values. Every secret is read
# from process.env only; nothing is hard-coded.

# --- core ---
PORT=3000
APP_VERSION=0.1.0
JWT_SECRET=
OTP_HMAC_SECRET=
# OTP_DEV_MODE=true  -> POST /auth/otp/request returns dev_code (staging only, NEVER production)
OTP_DEV_MODE=false

# --- supabase (Jaraa project ONLY — never the Nepal Shop project) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY is needed by the server ONLY for verifying Google OAuth
# tokens against Supabase Auth (/auth/v1/user). Safe for the client bundle.
SUPABASE_ANON_KEY=

# --- admin bootstrap (first boot only: creates the admin user if absent) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- email: Brevo HTTPS API only (Render blocks SMTP ports 25/465/587) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# --- email OTP ---
# Real OTP codes are sent via Brevo HTTPS (BREVO_API_KEY/BREVO_SENDER_EMAIL).
# Unset -> console.log dev adapter (no real email). Never SMTP (Render blocks it).
# Same OTP_HMAC_SECRET signs the codes; OTP_DEV_MODE=true also gates dev_code
# in the email-OTP /request response (staging only, NEVER production).

# --- phone SMS OTP ---
# SMS_PROVIDER=log -> dev adapter (codes logged to console only).
# VERIFY: real SMS needs a Nepal gateway account (SMS_PROVIDER/SMS_API_KEY/SMS_SENDER_ID).
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER_ID=

# --- Gemini photo-quality check (quality signals ONLY, never diagnoses) ---
# VERIFY: unset -> quality check is skipped ({skipped:true})
GEMINI_API_KEY=

# --- payments (VERIFY: real sandbox keys needed from founder) ---
# eSewa
ESEWA_MERCHANT_ID=
ESEWA_SECRET_KEY=
# Khalti
KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=

# --- misc ---
PUBLIC_BASE_URL=http://localhost:3000
